              }
            ]
          }
        ]
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_-]*"
    },
    "name_segment": {
      "type": "PATTERN",
      "value": "[^:\\r\\n]+"
    }
